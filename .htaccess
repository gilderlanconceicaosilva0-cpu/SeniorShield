# SeniorShield - protecao das rotas internas e arquivos de configuracao.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|src|database|tests|bin|includes)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(README\.md|spec\.md)$ - [F,L,NC]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
